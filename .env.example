# Lokale Collector-Konfiguration; echte Werte nur in .env speichern.
LLMTOP_COLLECTOR_TOKEN=<zufälliger-langer-wert>
LLMTOP_COLLECTOR_URL=http://127.0.0.1:11435

# Open-WebUI-Admin-API für --install-open-webui-adapter.
OPEN_WEBUI_URL=http://127.0.0.1:3000
OPEN_WEBUI_API_KEY=<Open-WebUI-Admin-API-Key>
